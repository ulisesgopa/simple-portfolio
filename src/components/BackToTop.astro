<div class="flex justify-center mt-10">
    <button id="back-to-top" class="inline-flex items-center justify-center gap-2 whitespace-nowrap text-sm font-medium [&_svg]:size-4 [&_svg]:shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor">
            <path d="M13.0001 7.82843V20H11.0001V7.82843L5.63614 13.1924L4.22192 11.7782L12.0001 4L19.7783 11.7782L18.3641 13.1924L13.0001 7.82843Z"></path>
        </svg>
        <span>Back to Top</span>
    </button>
</div>

<script>
    function attachBackToTop() {
        document.querySelector("#back-to-top")?.addEventListener("click", () => {
            window.scrollTo({ top: 0, behavior: "smooth" });
        });
    }

    // Initial load
    attachBackToTop();

    // Re-attach after every View Transition navigation
    document.addEventListener("astro:page-load", attachBackToTop);
</script>